<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>opcua-interop-dotnet-gds</AssemblyName>
    <RootNamespace>OpcUaInterop</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- the GDS server creates CultureInfo("en-US"): allow it in invariant mode (no ICU in the image) -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS0618</NoWarn>
    <!-- UA-.NETStandard 2.0.1 (the GDS packages are Opc.Ua.Gds.Client / Opc.Ua.Gds.Server since 2.0;
         1.5.378 shipped them as Gds.Client.Common / Gds.Server.Common). Every Opc.Ua package is
         pinned to exactly this version. -->
    <OpcUaVersion Condition="'$(OpcUaVersion)' == ''">2.0.1</OpcUaVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="[$(OpcUaVersion)]" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="[$(OpcUaVersion)]" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="[$(OpcUaVersion)]" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Gds.Client" Version="[$(OpcUaVersion)]" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Gds.Server" Version="[$(OpcUaVersion)]" />
  </ItemGroup>
</Project>
