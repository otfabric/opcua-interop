{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/opcua-interop/schemas/client-result.schema.json",
  "title": "opcua-interop client result",
  "description": "Schema for the single JSON object written to stdout by every opcua-interop client command.",
  "type": "object",
  "required": ["schemaVersion", "adapter", "operation", "success", "serviceResult", "results", "error"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "adapter": {
      "type": "string",
      "enum": ["open62541", "milo", "async-opcua", "dotnet", "node-opcua", "asyncua", "dotnet-gds"]
    },
    "operation": {
      "type": "string",
      "enum": [
        "endpoints", "find-servers", "read", "write", "browse", "translate",
        "call", "subscribe", "subscription-lifecycle", "event-subscribe",
        "history-read", "republish", "transfer-subscriptions",
        "register-nodes", "node-management",
        "find-servers-on-network", "register-server", "codec", "pubsub-discover",
        "alarms", "push", "query", "gds-pull",
        "history-read-events", "history-update-events"
      ]
    },
    "success": {
      "type": "boolean"
    },
    "serviceResult": {
      "$ref": "#/$defs/statusCode"
    },
    "results": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/endpointResult" },
          { "$ref": "#/$defs/findServersResult" },
          { "$ref": "#/$defs/readResult" },
          { "$ref": "#/$defs/writeResult" },
          { "$ref": "#/$defs/browseResult" },
          { "$ref": "#/$defs/translateResult" },
          { "$ref": "#/$defs/callResult" },
          { "$ref": "#/$defs/subscribeResult" },
          { "$ref": "#/$defs/subscriptionLifecycleResult" },
          { "$ref": "#/$defs/eventSubscribeResult" },
          { "$ref": "#/$defs/alarmsResult" },
          { "$ref": "#/$defs/historyReadResult" },
          { "$ref": "#/$defs/historyReadEventsResult" },
          { "$ref": "#/$defs/historyUpdateEventsResult" },
          { "$ref": "#/$defs/republishResult" },
          { "$ref": "#/$defs/transferSubscriptionsResult" },
          { "$ref": "#/$defs/registerNodesResult" },
          { "$ref": "#/$defs/nodeManagementResult" },
          { "$ref": "#/$defs/findServersOnNetworkResult" },
          { "$ref": "#/$defs/registerServerResult" },
          { "$ref": "#/$defs/codecEncodeResult" },
          { "$ref": "#/$defs/codecDecodeResult" },
          { "$ref": "#/$defs/codecNodeResult" },
          { "$ref": "#/$defs/gdsPullResult" }
        ]
      }
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/errorObject" }
      ]
    }
  },
  "$defs": {
    "statusCode": {
      "type": "object",
      "required": ["name", "code", "severity"],
      "additionalProperties": false,
      "properties": {
        "name":     { "type": "string" },
        "code":     { "type": "integer", "minimum": 0 },
        "severity": { "type": "string", "enum": ["Good", "Uncertain", "Bad"] }
      }
    },
    "errorObject": {
      "type": "object",
      "required": ["category", "message"],
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "enum": ["input", "transport", "service", "timeout", "internal"]
        },
        "message": { "type": "string" }
      }
    },
    "endpointResult": {
      "type": "object",
      "required": ["url", "securityPolicy", "securityMode"],
      "additionalProperties": false,
      "properties": {
        "url":            { "type": "string" },
        "securityPolicy": { "type": "string" },
        "securityMode":   { "type": "string" }
      }
    },
    "findServersResult": {
      "type": "object",
      "required": ["applicationUri", "applicationName", "productUri", "discoveryUrls"],
      "additionalProperties": false,
      "properties": {
        "applicationUri": { "type": "string" },
        "applicationName": {
          "type": "object",
          "required": ["locale", "text"],
          "properties": {
            "locale": { "type": "string" },
            "text":   { "type": "string" }
          }
        },
        "productUri": { "type": "string" },
        "discoveryUrls": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "readResult": {
      "type": "object",
      "required": ["nodeId", "statusCode", "dataType", "builtInType", "value"],
      "additionalProperties": false,
      "properties": {
        "nodeId":          { "type": "string" },
        "statusCode":      { "$ref": "#/$defs/statusCode" },
        "dataType":        { "type": "string" },
        "builtInType":     { "type": "integer", "minimum": 1, "maximum": 25 },
        "value":           {},
        "sourceTimestamp": { "type": "string" }
      }
    },
    "writeResult": {
      "type": "object",
      "required": ["nodeId", "statusCode"],
      "additionalProperties": false,
      "properties": {
        "nodeId":     { "type": "string" },
        "statusCode": { "$ref": "#/$defs/statusCode" }
      }
    },
    "browseResult": {
      "type": "object",
      "required": ["referenceTypeId", "isForward", "nodeId", "browseName", "displayName", "nodeClass"],
      "additionalProperties": false,
      "properties": {
        "referenceTypeId": { "type": "string" },
        "isForward":       { "type": "boolean" },
        "nodeId":          { "type": "string" },
        "browseName": {
          "type": "object",
          "required": ["ns", "name"],
          "properties": {
            "ns":   { "type": "integer" },
            "name": { "type": "string" }
          }
        },
        "displayName": {
          "type": "object",
          "required": ["locale", "text"],
          "properties": {
            "locale": { "type": "string" },
            "text":   { "type": "string" }
          }
        },
        "nodeClass": {
          "type": "string",
          "enum": ["Object","Variable","Method","ObjectType","VariableType","ReferenceType","DataType","View"]
        }
      }
    },
    "translateResult": {
      "type": "object",
      "required": ["statusCode", "targets"],
      "additionalProperties": false,
      "properties": {
        "statusCode": { "$ref": "#/$defs/statusCode" },
        "targets": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "subscribeResult": {
      "type": "object",
      "required": ["nodeId", "subscriptionId", "revisedPublishingInterval", "revisedLifetimeCount", "revisedMaxKeepAliveCount", "monitoredItemStatusCode", "notifications"],
      "additionalProperties": false,
      "properties": {
        "nodeId":                    { "type": "string" },
        "subscriptionId":            { "type": "integer", "minimum": 0 },
        "revisedPublishingInterval": { "type": "number" },
        "revisedLifetimeCount":      { "type": "integer", "minimum": 0 },
        "revisedMaxKeepAliveCount":  { "type": "integer", "minimum": 0 },
        "monitoredItemStatusCode":   { "$ref": "#/$defs/statusCode" },
        "monitoredItemId":           { "type": "integer", "minimum": 0 },
        "revisedSamplingInterval":   { "type": "number" },
        "revisedQueueSize":          { "type": "integer", "minimum": 0 },
        "filter": {
          "type": "object",
          "description": "Requested DataChangeFilter; present only with --deadband-absolute / --deadband-percent / --trigger.",
          "required": ["trigger", "deadbandType", "deadbandValue"],
          "additionalProperties": false,
          "properties": {
            "trigger":       { "type": "string", "enum": ["Status", "StatusValue", "StatusValueTimestamp"] },
            "deadbandType":  { "type": "string", "enum": ["None", "Absolute", "Percent"] },
            "deadbandValue": { "type": "number" }
          }
        },
        "filterResult": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "required": ["typeId"], "properties": { "typeId": { "type": "string" }, "typeName": { "type": "string" } } }
          ]
        },
        "notifications": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sequenceNumber", "value", "dataType", "builtInType", "statusCode"],
            "properties": {
              "sequenceNumber":  { "type": "integer" },
              "value":           {},
              "dataType":        { "type": "string" },
              "builtInType":     { "type": "integer" },
              "statusCode":      { "$ref": "#/$defs/statusCode" },
              "sourceTimestamp": { "type": "string" },
              "serverTimestamp": { "type": "string" }
            }
          }
        }
      }
    },
    "subscriptionLifecycleResult": {
      "type": "object",
      "required": ["subscriptionId"],
      "not": { "required": ["refresh"] },
      "properties": {
        "subscriptionId":              { "type": "integer", "minimum": 0 },
        "requestedPublishingInterval": { "type": "number" },
        "requestedLifetimeCount":      { "type": "integer" },
        "requestedMaxKeepAliveCount":  { "type": "integer" },
        "revisedPublishingInterval":   { "type": "number" },
        "revisedLifetimeCount":        { "type": "integer", "minimum": 0 },
        "revisedMaxKeepAliveCount":    { "type": "integer", "minimum": 0 },
        "overflow":                    { "type": "boolean" },
        "values":                      { "type": "array", "items": { "type": "integer" } },
        "modeSteps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["mode", "notificationCount"],
            "properties": {
              "mode":              { "type": "string" },
              "notificationCount": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "deleteMonitoredItem": {
          "type": "object",
          "required": ["first", "second"],
          "properties": {
            "first":  { "$ref": "#/$defs/statusCode" },
            "second": { "$ref": "#/$defs/statusCode" }
          }
        },
        "deleteSubscription": {
          "type": "object",
          "required": ["first", "second"],
          "properties": {
            "first":  { "$ref": "#/$defs/statusCode" },
            "second": { "$ref": "#/$defs/statusCode" }
          }
        }
      }
    },
    "eventSubscribeResult": {
      "type": "object",
      "required": ["nodeId", "subscriptionId", "revisedPublishingInterval", "monitoredItemStatusCode", "selectClauses", "events"],
      "additionalProperties": false,
      "properties": {
        "nodeId":                    { "type": "string" },
        "subscriptionId":            { "type": "integer", "minimum": 0 },
        "revisedPublishingInterval": { "type": "number" },
        "monitoredItemStatusCode":   { "$ref": "#/$defs/statusCode" },
        "selectClauses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sequenceNumber", "fields"],
            "properties": {
              "sequenceNumber": { "type": "integer" },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "dataType", "builtInType", "value"],
                  "properties": {
                    "name":         { "type": "string" },
                    "dataType":     { "type": "string" },
                    "builtInType":  { "type": "integer" },
                    "value":        {}
                  }
                }
              }
            }
          }
        }
      }
    },
    "callResult": {
      "type": "object",
      "required": ["objectNodeId", "methodNodeId", "statusCode", "outputArguments"],
      "additionalProperties": false,
      "properties": {
        "objectNodeId":    { "type": "string" },
        "methodNodeId":    { "type": "string" },
        "statusCode":      { "$ref": "#/$defs/statusCode" },
        "outputArguments": { "type": "array" }
      }
    },
    "alarmsResult": {
      "description": "client alarms (docs/CONTAINER_CONTRACT.md §4 alarms). Added in adapter 0.11.0.",
      "type": "object",
      "required": ["nodeId", "subscriptionId", "monitoredItemStatusCode", "refresh", "conditions", "target", "acknowledge", "confirm", "addComment"],
      "additionalProperties": false,
      "properties": {
        "nodeId":                  { "type": "string" },
        "subscriptionId":          { "type": "integer", "minimum": 0 },
        "monitoredItemStatusCode": { "$ref": "#/$defs/statusCode" },
        "refresh": {
          "type": "object",
          "required": ["statusCode", "startSeen", "endSeen"],
          "additionalProperties": false,
          "properties": {
            "statusCode": { "$ref": "#/$defs/statusCode" },
            "startSeen":  { "type": "boolean" },
            "endSeen":    { "type": "boolean" }
          }
        },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/conditionEntry" } },
        "target":     { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/conditionEntry" } ] },
        "acknowledge": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["statusCode", "event", "repeatStatusCode"],
              "additionalProperties": false,
              "properties": {
                "statusCode":       { "$ref": "#/$defs/statusCode" },
                "event":            { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/conditionEntry" } ] },
                "repeatStatusCode": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/statusCode" } ] }
              }
            }
          ]
        },
        "confirm":    { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/alarmAction" } ] },
        "addComment": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/alarmAction" } ] }
      }
    },
    "alarmAction": {
      "type": "object",
      "required": ["statusCode", "event"],
      "additionalProperties": false,
      "properties": {
        "statusCode": { "$ref": "#/$defs/statusCode" },
        "event":      { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/conditionEntry" } ] }
      }
    },
    "conditionEntry": {
      "description": "One condition event (alarms SelectClauses 0..15); a field whose event value is null, absent or a StatusCode is null.",
      "type": "object",
      "required": ["conditionId", "eventId", "eventType", "sourceNode", "sourceName", "conditionName", "time",
                   "message", "severity", "retain", "enabled", "acked", "confirmed", "active", "comment"],
      "additionalProperties": false,
      "properties": {
        "conditionId":   { "type": ["string", "null"] },
        "eventId":       { "type": ["string", "null"], "description": "base64" },
        "eventType":     { "type": ["string", "null"] },
        "sourceNode":    { "type": ["string", "null"] },
        "sourceName":    { "type": ["string", "null"] },
        "conditionName": { "type": ["string", "null"] },
        "time":          { "type": ["string", "null"] },
        "message":       { "type": ["string", "null"] },
        "severity":      { "type": ["integer", "null"] },
        "retain":        { "type": ["boolean", "null"] },
        "enabled":       { "type": ["boolean", "null"] },
        "acked":         { "type": ["boolean", "null"] },
        "confirmed":     { "type": ["boolean", "null"] },
        "active":        { "type": ["boolean", "null"] },
        "comment":       { "type": ["string", "null"] }
      }
    },
    "historyReadResult": {
      "type": "object",
      "required": ["nodeId", "statusCode", "continuationPoint", "values"],
      "additionalProperties": false,
      "properties": {
        "nodeId":            { "type": "string" },
        "statusCode":        { "$ref": "#/$defs/statusCode" },
        "continuationPoint": {
          "oneOf": [
            { "type": "null" },
            { "type": "string" }
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "dataType", "builtInType", "statusCode"],
            "properties": {
              "value":           {},
              "dataType":        { "type": "string" },
              "builtInType":     { "type": "integer" },
              "statusCode":      { "$ref": "#/$defs/statusCode" },
              "sourceTimestamp": { "type": "string" },
              "serverTimestamp": { "type": "string" }
            }
          }
        }
      }
    },
    "historyEventList": {
      "description": "Events of history-read-events (docs/CONTAINER_CONTRACT.md §4): fields by SelectClause index, values as in §7.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fields"],
        "additionalProperties": false,
        "properties": {
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "dataType", "builtInType", "value"],
              "properties": {
                "name":        { "type": "string" },
                "dataType":    { "type": "string" },
                "builtInType": { "type": "integer", "minimum": 0, "maximum": 25 },
                "value":       {}
              }
            }
          }
        }
      }
    },
    "historyReadEventsResult": {
      "description": "history-read-events, one per --node (adapter 0.17.0). scenario, pages, releaseStatusCode and reuseAfterReleaseStatusCode only with --scenario continue.",
      "type": "object",
      "required": ["nodeId", "statusCode", "continuationPoint", "selectClauses", "events"],
      "additionalProperties": false,
      "properties": {
        "scenario":          { "type": "string", "const": "continue" },
        "nodeId":            { "type": "string" },
        "statusCode":        { "$ref": "#/$defs/statusCode" },
        "continuationPoint": { "oneOf": [ { "type": "null" }, { "type": "string" } ] },
        "selectClauses":     { "type": "array", "items": { "type": "string" } },
        "events":            { "$ref": "#/$defs/historyEventList" },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["statusCode", "continuationPoint", "events"],
            "additionalProperties": false,
            "properties": {
              "statusCode":        { "$ref": "#/$defs/statusCode" },
              "continuationPoint": { "oneOf": [ { "type": "null" }, { "type": "string" } ] },
              "events":            { "$ref": "#/$defs/historyEventList" }
            }
          }
        },
        "releaseStatusCode":           { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/statusCode" } ] },
        "reuseAfterReleaseStatusCode": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/statusCode" } ] }
      }
    },
    "historyUpdateEventsResult": {
      "description": "history-update-events (adapter 0.17.0): the HistoryUpdateResult of the node.",
      "type": "object",
      "required": ["nodeId", "performUpdateType", "statusCode", "operationResults"],
      "additionalProperties": false,
      "properties": {
        "nodeId":            { "type": "string" },
        "performUpdateType": { "type": "string", "enum": ["Insert", "Replace", "Update", "Delete"] },
        "statusCode":        { "$ref": "#/$defs/statusCode" },
        "operationResults":  { "type": "array", "items": { "$ref": "#/$defs/statusCode" } }
      }
    },
    "republishResult": {
      "type": "object",
      "required": ["subscriptionId", "retransmitSequenceNumber"],
      "additionalProperties": false,
      "properties": {
        "subscriptionId":           { "type": "integer", "minimum": 0 },
        "retransmitSequenceNumber": { "type": "integer", "minimum": 0 },
        "sequenceNumber":           { "type": "integer", "minimum": 0 },
        "publishTime":              { "type": "string" },
        "notificationDataCount":    { "type": "integer", "minimum": 0 }
      }
    },
    "transferSubscriptionsResult": {
      "type": "object",
      "required": ["subscriptionId", "statusCode", "availableSequenceNumbers"],
      "additionalProperties": false,
      "properties": {
        "subscriptionId": { "type": "integer", "minimum": 0 },
        "statusCode":     { "$ref": "#/$defs/statusCode" },
        "availableSequenceNumbers": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "registerNodesResult": {
      "type": "object",
      "required": ["nodeId", "registeredNodeId", "statusCode", "unregisterStatusCode"],
      "additionalProperties": false,
      "properties": {
        "nodeId":               { "type": "string" },
        "registeredNodeId":     { "type": "string" },
        "statusCode":           { "$ref": "#/$defs/statusCode" },
        "dataType":             { "type": "string" },
        "builtInType":          { "type": "integer", "minimum": 1, "maximum": 25 },
        "value":                {},
        "unregisterStatusCode": { "$ref": "#/$defs/statusCode" }
      }
    },
    "nodeManagementResult": {
      "type": "object",
      "required": ["parentNodeId", "requestedNodeId", "addStatusCode"],
      "additionalProperties": false,
      "properties": {
        "parentNodeId":              { "type": "string" },
        "requestedNodeId":           { "type": "string" },
        "addStatusCode":             { "$ref": "#/$defs/statusCode" },
        "addedNodeId":               { "type": "string" },
        "readStatusCode":            { "$ref": "#/$defs/statusCode" },
        "dataType":                  { "type": "string" },
        "builtInType":               { "type": "integer", "minimum": 1, "maximum": 25 },
        "value":                     {},
        "deleteStatusCode":          { "$ref": "#/$defs/statusCode" },
        "readAfterDeleteStatusCode": { "$ref": "#/$defs/statusCode" }
      }
    },
    "findServersOnNetworkResult": {
      "type": "object",
      "required": ["recordId", "serverName", "discoveryUrl", "serverCapabilities"],
      "additionalProperties": false,
      "properties": {
        "recordId":             { "type": "integer", "minimum": 0 },
        "serverName":           { "type": "string" },
        "discoveryUrl":         { "type": "string" },
        "serverCapabilities":   { "type": "array", "items": { "type": "string" } },
        "lastCounterResetTime": { "type": "string" }
      }
    },
    "registerServerResult": {
      "type": "object",
      "required": ["service", "serverUri", "isOnline", "statusCode", "fallback", "configurationResults"],
      "additionalProperties": false,
      "properties": {
        "service":                   { "type": "string", "enum": ["RegisterServer2", "RegisterServer"] },
        "serverUri":                 { "type": "string" },
        "isOnline":                  { "type": "boolean" },
        "statusCode":                { "$ref": "#/$defs/statusCode" },
        "fallback":                  { "type": "boolean" },
        "registerServer2StatusCode": { "$ref": "#/$defs/statusCode" },
        "configurationResults":      { "type": "array", "items": { "$ref": "#/$defs/statusCode" } }
      }
    },
    "codecDocument": {
      "description": "A JSON / XML document embedded as a string, or null when the stack could not produce it.",
      "type": ["string", "null"]
    },
    "codecEncodeResult": {
      "type": "object",
      "required": ["action", "format", "source", "dataType", "builtInType", "valueRank", "value", "dataValue", "encoded", "statusCodes", "binary"],
      "additionalProperties": false,
      "properties": {
        "action":          { "const": "encode" },
        "format":          { "type": "string", "enum": ["json", "xml"] },
        "jsonMode":        { "type": "string", "enum": ["compact", "verbose"] },
        "source":          { "type": "string", "enum": ["literal", "node"] },
        "nodeId":          { "type": "string" },
        "dataType":        { "type": "string" },
        "builtInType":     { "type": "integer", "minimum": 0, "maximum": 25 },
        "valueRank":       { "type": "integer" },
        "arrayDimensions": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "value":           {},
        "dataValue":       { "type": "object" },
        "encoded": {
          "type": "object",
          "required": ["variant", "dataValue"],
          "additionalProperties": false,
          "properties": {
            "value":     { "$ref": "#/$defs/codecDocument" },
            "variant":   { "$ref": "#/$defs/codecDocument" },
            "dataValue": { "$ref": "#/$defs/codecDocument" }
          }
        },
        "statusCodes": {
          "type": "object",
          "required": ["variant", "dataValue"],
          "additionalProperties": false,
          "properties": {
            "value":     { "$ref": "#/$defs/statusCode" },
            "variant":   { "$ref": "#/$defs/statusCode" },
            "dataValue": { "$ref": "#/$defs/statusCode" }
          }
        },
        "binary": {
          "type": "object",
          "description": "OPC UA Binary encodings, Base64.",
          "required": ["variant", "dataValue"],
          "additionalProperties": false,
          "properties": {
            "value":     { "type": ["string", "null"] },
            "variant":   { "type": ["string", "null"] },
            "dataValue": { "type": ["string", "null"] }
          }
        }
      }
    },
    "codecDecodeResult": {
      "type": "object",
      "required": ["action", "format", "type", "statusCode"],
      "additionalProperties": false,
      "properties": {
        "action":          { "const": "decode" },
        "format":          { "type": "string", "enum": ["json", "xml"] },
        "jsonMode":        { "type": "string", "enum": ["compact", "verbose"] },
        "type":            { "type": "string" },
        "statusCode":      { "$ref": "#/$defs/statusCode" },
        "dataType":        { "type": "string" },
        "builtInType":     { "type": "integer", "minimum": 0, "maximum": 25 },
        "valueRank":       { "type": "integer" },
        "arrayDimensions": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "value":           {},
        "dataValue":       { "type": "object" },
        "binary":          { "type": ["string", "null"] },
        "reencoded":       { "$ref": "#/$defs/codecDocument" }
      }
    },
    "codecNodeResult": {
      "type": "object",
      "required": ["nodeId", "statusCode", "json", "xml"],
      "additionalProperties": false,
      "properties": {
        "nodeId":          { "type": "string" },
        "statusCode":      { "$ref": "#/$defs/statusCode" },
        "dataType":        { "type": "string" },
        "builtInType":     { "type": "integer", "minimum": 0, "maximum": 25 },
        "valueRank":       { "type": "integer" },
        "arrayDimensions": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "value":           {},
        "json":            { "$ref": "#/$defs/codecDocument" },
        "xml":             { "$ref": "#/$defs/codecDocument" },
        "dataValueJson":   { "$ref": "#/$defs/codecDocument" },
        "dataValueXml":    { "$ref": "#/$defs/codecDocument" },
        "binary":          { "type": ["string", "null"] },
        "dataValueBinary": { "type": ["string", "null"] }
      }
    },
    "gdsPullResult": {
      "description": "client gds-pull (docs/CONTAINER_CONTRACT.md §16.2). A key is present only when its step ran; FindApplications always runs.",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [ { "required": ["findApplications"] }, { "required": ["findApplicationsStatus"] } ],
      "properties": {
        "findApplications":           { "type": "array", "items": { "type": "string" } },
        "findApplicationsStatus":     { "$ref": "#/$defs/statusCode" },
        "registered":                 { "type": "boolean" },
        "registerStatus":             { "$ref": "#/$defs/statusCode" },
        "applicationId":              { "type": "string" },
        "requestKind":                { "type": "string", "enum": ["csr", "new-key-pair"] },
        "startRequestStatus":         { "$ref": "#/$defs/statusCode" },
        "requestId":                  { "type": "string" },
        "finishRequestStatus":        { "$ref": "#/$defs/statusCode" },
        "certificate":                { "type": "string" },
        "privateKeyFormat":           { "type": "string" },
        "privateKey":                 { "type": "string" },
        "issuerCertificates":         { "type": "array", "items": { "type": "string" } },
        "certificateGroups":          { "type": "array", "items": { "type": "string" } },
        "getCertificateGroupsStatus": { "$ref": "#/$defs/statusCode" },
        "trustListId":                { "type": "string" },
        "getTrustListStatus":         { "$ref": "#/$defs/statusCode" },
        "trustList": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "specifiedLists":      { "type": "integer", "minimum": 0 },
            "trustedCertificates": { "type": "array", "items": { "type": "string" } },
            "trustedCrls":         { "type": "array", "items": { "type": "string" } },
            "issuerCertificates":  { "type": "array", "items": { "type": "string" } },
            "issuerCrls":          { "type": "array", "items": { "type": "string" } }
          }
        },
        "readTrustListStatus":        { "$ref": "#/$defs/statusCode" },
        "getCertificateStatusStatus": { "$ref": "#/$defs/statusCode" },
        "updateRequired":             { "type": "boolean" },
        "revokeStatus":               { "$ref": "#/$defs/statusCode" },
        "checkRevocationStatus":      { "$ref": "#/$defs/statusCode" },
        "certificateStatus":          { "$ref": "#/$defs/statusCode" },
        "unregisterStatus":           { "$ref": "#/$defs/statusCode" }
      }
    }
  }
}
