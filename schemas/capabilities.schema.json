{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/opcua-interop/schemas/capabilities.schema.json",
  "title": "opcua-interop adapter capabilities",
  "description": "Schema for the JSON object written to stdout by the print-capabilities subcommand.",
  "type": "object",
  "required": ["schemaVersion", "adapter", "stack", "fixtureSchemaVersions", "roles", "transports", "encodings", "clientOperations", "serverServices", "securityProfiles", "userTokenTypes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "adapter": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name":    { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "stack": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name":    { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "fixtureSchemaVersions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "roles": {
      "type": "array",
      "items": { "type": "string", "enum": ["client", "server"] }
    },
    "transports": {
      "type": "array",
      "items": { "type": "string" }
    },
    "encodings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "clientOperations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "clientFeatures": {
      "type": "array",
      "description": "Optional client-side features (docs/CLIENT_CONTRACT.md §13). Added in adapter 0.7.0.",
      "items": {
        "type": "string",
        "enum": ["channel-lifetime", "deadband", "reverse-listen", "ecc-security", "ecc-user-token",
                 "application-uri", "register-server2", "codec-json", "codec-xml", "codec-json-verbose"]
      }
    },
    "serverFeatures": {
      "type": "array",
      "description": "Optional server-side features (docs/CLIENT_CONTRACT.md §13). Added in adapter 0.7.0.",
      "items": {
        "type": "string",
        "enum": ["deadband", "percent-deadband", "reverse-connect", "ecc-security", "ecc-user-token",
                 "lds", "mdns", "register-with", "node-management"]
      }
    },
    "codec": {
      "type": "object",
      "description": "What the `client codec` command can do. Added in adapter 0.7.0.",
      "required": ["formats", "jsonVersion", "jsonModes"],
      "additionalProperties": false,
      "properties": {
        "formats":     { "type": "array", "items": { "type": "string", "enum": ["json", "xml"] } },
        "jsonVersion": { "type": "string" },
        "jsonModes":   { "type": "array", "items": { "type": "string", "enum": ["compact", "verbose"] } },
        "xmlEncodeUnsupported": { "type": "array", "items": { "type": "string" } },
        "xmlDecodeUnsupported": { "type": "array", "items": { "type": "string" } }
      }
    },
    "serverServices": {
      "type": "array",
      "items": { "type": "string" }
    },
    "securityProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["policy", "mode"],
        "properties": {
          "policy": { "type": "string" },
          "mode":   { "type": "string" }
        }
      }
    },
    "userTokenTypes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
