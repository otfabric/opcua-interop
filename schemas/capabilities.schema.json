{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/opcua-interop/schemas/capabilities.schema.json",
  "title": "opcua-interop adapter capabilities",
  "description": "Schema for the JSON object written to stdout by the print-capabilities subcommand.",
  "type": "object",
  "required": ["schemaVersion", "adapter", "stack", "fixtureSchemaVersions", "roles", "transports", "encodings", "clientOperations", "serverServices", "securityProfiles", "userTokenTypes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "adapter": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name":    { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "stack": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name":    { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "fixtureSchemaVersions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "roles": {
      "type": "array",
      "items": { "type": "string", "enum": ["client", "server"] }
    },
    "transports": {
      "type": "array",
      "items": { "type": "string" }
    },
    "encodings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "clientOperations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "clientFeatures": {
      "type": "array",
      "description": "Optional client-side features (docs/CLIENT_CONTRACT.md §13). Added in adapter 0.7.0; codec-pubsub in 0.8.0.",
      "items": {
        "type": "string",
        "enum": ["channel-lifetime", "deadband", "reverse-listen", "ecc-security", "ecc-user-token",
                 "application-uri", "register-server2", "codec-json", "codec-xml", "codec-json-verbose",
                 "codec-pubsub"]
      }
    },
    "serverFeatures": {
      "type": "array",
      "description": "Optional server-side features (docs/CLIENT_CONTRACT.md §13). Added in adapter 0.7.0; pubsub in 0.8.0; alarms in 0.11.0; push-management in 0.13.0; gds-pull in 0.14.0.",
      "items": {
        "type": "string",
        "enum": ["deadband", "percent-deadband", "reverse-connect", "ecc-security", "ecc-user-token",
                 "lds", "mdns", "register-with", "node-management", "pubsub", "alarms",
                 "push-management", "gds-pull"]
      }
    },
    "codec": {
      "type": "object",
      "description": "What the `client codec` command can do. Added in adapter 0.7.0.",
      "required": ["formats", "jsonVersion", "jsonModes"],
      "additionalProperties": false,
      "properties": {
        "formats":     { "type": "array", "items": { "type": "string", "enum": ["json", "xml"] } },
        "jsonVersion": { "type": "string" },
        "jsonModes":   { "type": "array", "items": { "type": "string", "enum": ["compact", "verbose"] } },
        "xmlEncodeUnsupported": { "type": "array", "items": { "type": "string" } },
        "xmlDecodeUnsupported": { "type": "array", "items": { "type": "string" } }
      }
    },
    "pubsub": {
      "type": "object",
      "description": "OPC UA PubSub (Part 14) support (docs/CLIENT_CONTRACT.md §14). Added in adapter 0.8.0. An adapter without PubSub declares supported=false with empty lists.",
      "required": ["supported", "transports", "encodings", "securityPolicies", "sks", "informationModel", "codecOps"],
      "additionalProperties": false,
      "properties": {
        "supported":          { "type": "boolean" },
        "reason":             { "type": "string", "description": "Why PubSub is not supported (supported=false only)." },
        "serverFlag":         { "type": "string", "description": "The server flag that takes the PubSub configuration file." },
        "roles":              { "type": "array", "items": { "type": "string", "enum": ["publisher", "subscriber"] } },
        "transports":         { "type": "array", "items": { "type": "string", "enum": ["udp-uadp", "mqtt-uadp", "mqtt-json", "eth-uadp", "amqp-uadp", "amqp-json"] } },
        "transportProfiles":  { "type": "array", "items": { "type": "string" } },
        "udp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unicast":   { "type": "boolean" },
            "multicast": { "type": "boolean" }
          }
        },
        "mqttVersions":       { "type": "array", "description": "MQTT protocol versions the MQTT transports connect with, the default first; per-version restrictions are in docs/CLIENT_CONTRACT.md §14.13. Added in adapter 0.10.0.", "items": { "type": "string", "enum": ["3.1", "3.1.1", "5.0"] } },
        "encodings":          { "type": "array", "items": { "type": "string", "enum": ["uadp", "json"] } },
        "fieldEncodings":     { "type": "array", "items": { "type": "string", "enum": ["Variant", "DataValue", "RawData"] } },
        "dataSetMessageTypes": {
          "type": "object",
          "description": "Per encoding (uadp, json): the DataSetMessage types the adapter encodes and decodes.",
          "additionalProperties": { "type": "array", "items": { "type": "string", "enum": ["KeyFrame", "DeltaFrame", "Event", "KeepAlive"] } }
        },
        "publishedDataSets":  { "type": "array", "items": { "type": "string", "enum": ["PublishedDataItems", "PublishedEvents"] } },
        "subscribedDataSets": { "type": "array", "items": { "type": "string", "enum": ["TargetVariables", "SubscribedDataSetMirror"] } },
        "securityPolicies":   { "type": "array", "items": { "type": "string" } },
        "securityModes":      { "type": "array", "items": { "type": "string", "enum": ["None", "Sign", "SignAndEncrypt"] } },
        "securityEncodings":  { "type": "array", "items": { "type": "string", "enum": ["uadp", "json"] } },
        "keySources":         { "type": "array", "items": { "type": "string", "enum": ["static", "sks-pull", "sks-push", "sks-server"] } },
        "sks": {
          "type": "object",
          "required": ["server", "pull", "push"],
          "additionalProperties": false,
          "properties": {
            "server":  { "type": "boolean" },
            "pull":    { "type": "boolean" },
            "push":    { "type": "boolean" },
            "methods": { "type": "array", "items": { "type": "string" } }
          }
        },
        "informationModel":        { "type": "boolean" },
        "informationModelMethods": { "type": "array", "items": { "type": "string" } },
        "chunking":           { "type": "boolean", "description": "A WriterGroup MaxNetworkMessageSize splits larger UADP NetworkMessages into chunks, and subscribers reassemble them (Part 14 §7.2.4.4.4). Added in adapter 0.10.0." },
        "discovery": {
          "type": "object",
          "description": "UADP discovery on datagram connections (Part 14 §7.2.4.6). Added in adapter 0.10.0.",
          "additionalProperties": false,
          "properties": {
            "layout":          { "type": "string", "enum": ["spec", "dotnet"], "description": "Byte layout of probes and announcements: Part 14 (spec), or that of Opc.Ua.PubSub 2.x (dotnet, docs/CLIENT_CONTRACT.md §14.13)." },
            "respond":         { "type": "array", "description": "Probe types a --pubsub-config publisher answers.", "items": { "type": "string", "enum": ["DataSetMetaData", "DataSetWriterConfiguration", "PublisherEndpoints"] } },
            "probe":           { "type": "array", "description": "Probe types the client operation sends.", "items": { "type": "string", "enum": ["DataSetMetaData", "DataSetWriterConfiguration", "PublisherEndpoints"] } },
            "clientOperation": { "type": "string", "description": "The client operation that sends a probe and prints the announcements." }
          }
        },
        "codecOps":           { "type": "array", "items": { "type": "string", "enum": ["pubsub-uadp-encode", "pubsub-uadp-decode", "pubsub-json-encode", "pubsub-json-decode"] } },
        "codecSecurity":      { "type": "boolean", "description": "Whether the codec ops sign / encrypt / verify / decrypt (false: SecurityHeader fields only)." }
      }
    },
    "serverServices": {
      "type": "array",
      "items": { "type": "string" }
    },
    "securityProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["policy", "mode"],
        "properties": {
          "policy": { "type": "string" },
          "mode":   { "type": "string" }
        }
      }
    },
    "userTokenTypes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
